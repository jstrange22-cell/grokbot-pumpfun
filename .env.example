# Secrets for docker compose. Copy to .env — it is gitignored.
# Keep GROKBOT_MODE=dry-run until a human writes "promote".
# Hostinger Compose-from-URL copies this file into Environment on every Update.
# Leave GROKBOT_GROK_API_KEY empty here so a real key is not overwritten by the dummy.
GROKBOT_MODE=dry-run
GROKBOT_GROK_API_KEY=
GROKBOT_DATA_API_KEY=
# Live only. Leave empty in dry-run. Dedicated hot wallet — never a Phantom/SafePal seed.
GROKBOT_WALLET_PRIVATE_KEY=
GROKBOT_LOG_LEVEL=INFO
# Presence of this file blocks new buys. Exits on open positions still run.
# In Docker the state volume is already mounted, so state/KILL is visible on the host.
GROKBOT_KILL_FILE=/app/state/KILL
